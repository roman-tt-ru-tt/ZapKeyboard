<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/zap_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvTitle"
        android:text="⚡ Zap"
        android:textColor="@color/zap_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnAdd"
        android:text="+ Добавить шаблон"
        android:textColor="@color/zap_text"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:background="@color/zap_primary"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnEnableKeyboard"
        android:text="⌨️ Включить клавиатуру"
        android:textColor="@color/zap_text"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:background="@color/zap_ok"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnSwitchKeyboard"
        android:text="🔄 Сменить клавиатуру"
        android:textColor="@color/zap_text"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:background="@color/zap_accent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Мои шаблоны:"
        android:textColor="@color/zap_text_secondary"
        android:textSize="14sp"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/listContainer"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
